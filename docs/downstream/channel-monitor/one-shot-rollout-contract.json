{
  "schema_version": 2,
  "rollout_mode": "one_shot",
  "partial_rollout_forbidden": true,
  "redis_requirements": {
    "minimum_version": "6.2",
    "required_commands": [
      "XAUTOCLAIM"
    ],
    "persistence": "aof_or_managed_equivalent",
    "evidence_commands": [
      "redis-cli INFO server",
      "redis-cli COMMAND INFO XAUTOCLAIM",
      "redis-cli CONFIG GET appendonly appendfsync save",
      "redis-cli INFO persistence"
    ]
  },
  "configuration": [
    {
      "name": "REDIS_CLIENT_POOL_ISOLATION",
      "default": "true",
      "kind": "emergency_rollback",
      "implemented": true
    },
    {
      "name": "REDIS_POOL_SIZE",
      "default": "10",
      "kind": "capacity",
      "implemented": true
    },
    {
      "name": "REDIS_MONITOR_WRITE_POOL_SIZE",
      "default": "4",
      "kind": "capacity",
      "implemented": true
    },
    {
      "name": "REDIS_MONITOR_READ_POOL_SIZE",
      "default": "8",
      "kind": "capacity",
      "implemented": true
    },
    {
      "name": "REDIS_MONITOR_CONSUMER_POOL_SIZE",
      "default": "4",
      "kind": "capacity",
      "implemented": true
    },
    {
      "name": "REDIS_CONSUMER_POOL_SIZE",
      "default": "4",
      "kind": "legacy_capacity_alias",
      "implemented": true,
      "alias_for": "REDIS_MONITOR_CONSUMER_POOL_SIZE",
      "precedence": "used_when_primary_is_unset_or_non_positive"
    },
    {
      "name": "CHANNEL_MONITOR_EVENT_WRITER_QUEUE_CAPACITY",
      "default": "8192",
      "kind": "capacity",
      "implemented": true
    },
    {
      "name": "CHANNEL_STATUS_PROBE_OVERVIEW_CACHE_TTL_MS",
      "default": "3000",
      "kind": "cache",
      "implemented": true
    },
    {
      "name": "CHANNEL_STATUS_PROBE_OVERVIEW_STALE_TTL_MS",
      "default": "30000",
      "kind": "cache",
      "implemented": true
    },
    {
      "name": "CHANNEL_STATUS_PROBE_OVERVIEW_REDIS_TTL_SECONDS",
      "default": "60",
      "kind": "cache",
      "implemented": true
    },
    {
      "name": "CHANNEL_MODEL_DETECTION_OVERVIEW_CACHE_TTL_MS",
      "default": "1000",
      "kind": "cache",
      "implemented": true
    },
    {
      "name": "CHANNEL_MODEL_DETECTION_OVERVIEW_STALE_TTL_MS",
      "default": "300000",
      "kind": "cache",
      "implemented": true
    },
    {
      "name": "CHANNEL_MODEL_DETECTION_OVERVIEW_REDIS_TTL_SECONDS",
      "default": "600",
      "kind": "cache",
      "implemented": true
    },
    {
      "name": "CHANNEL_DAILY_COST_RELIABLE_OUTBOX",
      "default": "true",
      "kind": "emergency_rollback",
      "implemented": true
    },
    {
      "name": "CHANNEL_SMART_SCHEDULE_ROUTE_SNAPSHOT_MAX_AGE_SECONDS",
      "default": "300",
      "kind": "safety_limit",
      "implemented": true
    }
  ],
  "required_signals": [
    "writer_queue_depth",
    "writer_queue_capacity",
    "writer_queue_utilization",
    "writer_dropped_events",
    "writer_retry_events",
    "consumer_lag_seconds",
    "page_snapshot_age_seconds",
    "event_watermark",
    "status_probe_snapshot_age_seconds",
    "status_probe_snapshot_revision",
    "model_detection_snapshot_age_seconds",
    "model_detection_snapshot_revision",
    "route_snapshot_age_seconds",
    "route_snapshot_revision",
    "cost_stream_pending_count",
    "cost_stream_unread_count",
    "cost_outbox_pending_count",
    "cost_outbox_oldest_pending_at",
    "cost_outbox_retry_count",
    "cost_publish_failed_count",
    "cost_dead_letter_count",
    "cost_ledger_failed_count",
    "redis_pool_stats.user.timeouts",
    "redis_pool_stats.monitor_write.timeouts",
    "redis_pool_stats.monitor_read.timeouts",
    "redis_pool_stats.monitor_consumer.timeouts"
  ],
  "signal_sources": [
    {
      "signal": "writer_queue_depth",
      "api": "/api/channel_monitor/",
      "json_path": "data.writer_queue_depth",
      "kind": "gauge"
    },
    {
      "signal": "writer_queue_capacity",
      "api": "/api/channel_monitor/",
      "json_path": "data.writer_queue_capacity",
      "kind": "gauge"
    },
    {
      "signal": "writer_queue_utilization",
      "api": "/api/channel_monitor/",
      "json_path": "data.writer_queue_depth / data.writer_queue_capacity",
      "kind": "derived_gauge"
    },
    {
      "signal": "writer_dropped_events",
      "api": "/api/channel_monitor/",
      "json_path": "data.writer_dropped_events",
      "kind": "process_counter"
    },
    {
      "signal": "writer_retry_events",
      "api": "/api/channel_monitor/",
      "json_path": "data.writer_retry_events",
      "kind": "process_counter"
    },
    {
      "signal": "consumer_lag_seconds",
      "api": "/api/channel_monitor/",
      "json_path": "data.consumer_lag_seconds",
      "kind": "gauge"
    },
    {
      "signal": "page_snapshot_age_seconds",
      "api": "/api/channel_monitor/ and cached page endpoints",
      "json_path": "now_unix - data.generated_at",
      "kind": "derived_gauge"
    },
    {
      "signal": "event_watermark",
      "api": "/api/channel_monitor/ and cached page endpoints",
      "json_path": "data.event_watermark",
      "kind": "monotonic_watermark"
    },
    {
      "signal": "status_probe_snapshot_revision",
      "api": "/api/channel_monitor/status",
      "json_path": "data.snapshot_revision",
      "kind": "monotonic_revision"
    },
    {
      "signal": "status_probe_snapshot_age_seconds",
      "api": "/api/channel_monitor/status",
      "json_path": "data.snapshot_age_seconds",
      "kind": "gauge"
    },
    {
      "signal": "model_detection_snapshot_revision",
      "api": "/api/channel_monitor/model_detection",
      "json_path": "data.snapshot_revision",
      "kind": "monotonic_revision"
    },
    {
      "signal": "model_detection_snapshot_age_seconds",
      "api": "/api/channel_monitor/model_detection",
      "json_path": "data.snapshot_age_seconds",
      "kind": "gauge"
    },
    {
      "signal": "route_snapshot_revision",
      "api": "/api/channel_monitor/schedule?metrics=true",
      "json_path": "data.route_snapshot.revision",
      "kind": "monotonic_revision"
    },
    {
      "signal": "route_snapshot_age_seconds",
      "api": "/api/channel_monitor/schedule?metrics=true",
      "json_path": "data.route_snapshot.snapshot_age_seconds",
      "kind": "gauge"
    },
    {
      "signal": "cost_stream_pending_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_stream_pending_count",
      "kind": "gauge"
    },
    {
      "signal": "cost_stream_unread_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_stream_unread_count",
      "kind": "gauge"
    },
    {
      "signal": "cost_outbox_pending_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_outbox_pending_count",
      "kind": "gauge"
    },
    {
      "signal": "cost_outbox_oldest_pending_at",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_outbox_oldest_pending_at",
      "kind": "unix_timestamp_gauge"
    },
    {
      "signal": "cost_outbox_retry_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_outbox_retry_count",
      "kind": "pending_rows_gauge"
    },
    {
      "signal": "cost_publish_failed_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_publish_failed_count",
      "kind": "process_counter"
    },
    {
      "signal": "cost_dead_letter_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_dead_letter_count",
      "kind": "process_counter"
    },
    {
      "signal": "cost_ledger_failed_count",
      "api": "/api/channel_monitor/",
      "json_path": "data.cost_ledger_failed_count",
      "kind": "process_counter"
    },
    {
      "signal": "redis_pool_stats.*.timeouts",
      "api": "/api/channel_monitor/",
      "json_path": "data.redis_pool_stats.{user,monitor_write,monitor_read,monitor_consumer}.timeouts",
      "kind": "client_counter"
    },
    {
      "signal": "redis_pool_stats.user.timeouts",
      "api": "/api/channel_monitor/",
      "json_path": "data.redis_pool_stats.user.timeouts",
      "kind": "client_counter"
    },
    {
      "signal": "redis_pool_stats.monitor_write.timeouts",
      "api": "/api/channel_monitor/",
      "json_path": "data.redis_pool_stats.monitor_write.timeouts",
      "kind": "client_counter"
    },
    {
      "signal": "redis_pool_stats.monitor_read.timeouts",
      "api": "/api/channel_monitor/",
      "json_path": "data.redis_pool_stats.monitor_read.timeouts",
      "kind": "client_counter"
    },
    {
      "signal": "redis_pool_stats.monitor_consumer.timeouts",
      "api": "/api/channel_monitor/",
      "json_path": "data.redis_pool_stats.monitor_consumer.timeouts",
      "kind": "client_counter"
    }
  ],
  "alert_delivery_contract": {
    "required_labels": [
      "instance",
      "chain",
      "severity"
    ],
    "required_annotations": [
      "current_value",
      "watermark_or_revision",
      "runbook"
    ]
  },
  "alerts": [
    {
      "id": "channel_monitor_writer_drop",
      "severity": "critical",
      "signal": "writer_dropped_events",
      "condition": "increase_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_writer_queue_high",
      "severity": "warning",
      "signal": "writer_queue_utilization",
      "condition": "gte",
      "threshold": 0.8,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_writer_retry",
      "severity": "warning",
      "signal": "writer_retry_events",
      "condition": "increase_gte",
      "threshold": 10,
      "window_seconds": 300
    },
    {
      "id": "channel_monitor_consumer_lag",
      "severity": "critical",
      "signal": "consumer_lag_seconds",
      "condition": "gte",
      "threshold": 30,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_page_snapshot_age",
      "severity": "critical",
      "signal": "page_snapshot_age_seconds",
      "condition": "gte",
      "threshold": 30,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_status_probe_snapshot_age",
      "severity": "critical",
      "signal": "status_probe_snapshot_age_seconds",
      "condition": "gte",
      "threshold": 30,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_model_detection_snapshot_age",
      "severity": "critical",
      "signal": "model_detection_snapshot_age_seconds",
      "condition": "gte",
      "threshold": 30,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_route_snapshot_age",
      "severity": "critical",
      "signal": "route_snapshot_age_seconds",
      "condition": "gte",
      "threshold": 30,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_event_watermark_regression",
      "severity": "critical",
      "signal": "event_watermark",
      "condition": "decrease_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_status_probe_revision_regression",
      "severity": "critical",
      "signal": "status_probe_snapshot_revision",
      "condition": "decrease_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_model_detection_revision_regression",
      "severity": "critical",
      "signal": "model_detection_snapshot_revision",
      "condition": "decrease_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_route_revision_regression",
      "severity": "critical",
      "signal": "route_snapshot_revision",
      "condition": "decrease_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_cost_stream_pending",
      "severity": "critical",
      "signal": "cost_stream_pending_count",
      "condition": "gte",
      "threshold": 1,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_cost_stream_unread",
      "severity": "critical",
      "signal": "cost_stream_unread_count",
      "condition": "gte",
      "threshold": 1,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_cost_outbox_pending",
      "severity": "critical",
      "signal": "cost_outbox_pending_count",
      "condition": "gte",
      "threshold": 1,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_cost_outbox_oldest",
      "severity": "critical",
      "signal": "cost_outbox_oldest_pending_at",
      "condition": "age_seconds_gte",
      "threshold": 30,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_cost_outbox_retry",
      "severity": "warning",
      "signal": "cost_outbox_retry_count",
      "condition": "gte",
      "threshold": 1,
      "window_seconds": 120
    },
    {
      "id": "channel_monitor_cost_ledger_failed",
      "severity": "critical",
      "signal": "cost_ledger_failed_count",
      "condition": "increase_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_cost_publish_failed",
      "severity": "critical",
      "signal": "cost_publish_failed_count",
      "condition": "increase_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_cost_dead_letter",
      "severity": "critical",
      "signal": "cost_dead_letter_count",
      "condition": "increase_gt",
      "threshold": 0,
      "window_seconds": 60
    },
    {
      "id": "channel_monitor_redis_pool_wait",
      "severity": "warning",
      "signal": "redis_pool_stats.*.timeouts",
      "condition": "increase_gt",
      "threshold": 0,
      "window_seconds": 60
    }
  ],
  "hard_gates": [
    {
      "id": "cm01_bounded_event_writer",
      "required": true,
      "current_status": "complete",
      "evidence": "service/channel_monitor_event_writer_test.go; service/channel_monitor_event_writer_cm08_test.go"
    },
    {
      "id": "cm03_redis_pool_isolation",
      "required": true,
      "current_status": "complete",
      "evidence": "common/redis_pool_test.go; service/channel_monitor_redis_pool_roles_test.go"
    },
    {
      "id": "cm02_versioned_route_snapshot",
      "required": true,
      "current_status": "complete",
      "evidence": "model/channel_smart_schedule_redis_snapshot_test.go; model/channel_smart_schedule_refresh_cm08_test.go"
    },
    {
      "id": "cm04_unified_page_snapshot",
      "required": true,
      "current_status": "complete",
      "evidence": "service/channel_monitor_page_snapshot_test.go; controller/channel_monitor_page_snapshot_test.go"
    },
    {
      "id": "cm05_redis_task_snapshots",
      "required": true,
      "current_status": "complete",
      "evidence": "controller/channel_status_probe_overview_cache_test.go; service/channel_model_detection_overview_cache_test.go"
    },
    {
      "id": "cm06_frontend_refresh_convergence",
      "required": true,
      "current_status": "complete",
      "evidence": "web/src/features/channel-monitor/lib/__tests__/query-options.test.ts"
    },
    {
      "id": "cm07_recoverable_cost_outbox",
      "required": true,
      "current_status": "complete",
      "evidence": "service/channel_daily_cost_outbox_cm07_test.go; model/channel_daily_cost_outbox_test.go"
    },
    {
      "id": "cm08_deterministic_failure_recovery_tests",
      "required": true,
      "current_status": "complete",
      "evidence": "deterministic Go tests only; isolated-environment gates remain separate"
    },
    {
      "id": "alert_rules_installed",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "alert_delivery_test",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "target_redis_compatibility_and_persistence_evidence",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "cm10_load_matrix_100_500_1000_by_10_50",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "cm10_real_fault_and_recovery_matrix",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "cm10_cross_instance_takeover",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "cm10_zero_difference_reconciliation",
      "required": true,
      "current_status": "missing"
    },
    {
      "id": "cm10_one_shot_rollback_drill",
      "required": true,
      "current_status": "missing"
    }
  ]
}
